# Use uma senha de app do Google (não a senha normal da conta).
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app-do-google

# Deve corresponder ao Site associado à Social Application do Google no admin.
SITE_ID=1

# Em produção, defina os hosts/domínios permitidos pelo Django.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Configure quando o fluxo do Langflow estiver disponível.
LANGFLOW_BASE_URL=http://localhost:7860
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=
